<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- pinned at H0 (CLAUDE.md §2): Boot 4.1.2 -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.nocook</groupId>
    <artifactId>nocook-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>nocook-parent</name>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- pgjdbc sends the JVM zone; Postgres 18 rejects the legacy id Asia/Calcutta -->
                    <argLine>-Duser.timezone=UTC</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>nocook-domain</module>
        <module>nocook-service</module>
        <module>mock-oms</module>
        <module>nocook-sim</module>
    </modules>
</project>
