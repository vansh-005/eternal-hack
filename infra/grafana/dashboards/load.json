    {
      "id": 204,
      "type": "timeseries",
      "title": "CPU per replica",
      "description": "Proof label: MEASURED. process.cpu.usage of each JVM (nocook replicas and mock-oms) and system.cpu.usage of the host/container seen by the JVM.",
